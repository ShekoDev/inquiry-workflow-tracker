rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /inquiries/{inquiryId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 3 * 1024 * 1024;
    }
    match /company/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
